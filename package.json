{
  "name": "principia",
  "private": true,
  "version": "0.0.0",
  "description": "只给自己用的本地数学物理学习网站",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && tsx server/main.ts",
    "start:lan": "vite build && tsx server/main.ts --lan",
    "serve": "tsx server/main.ts",
    "preview": "vite preview",
    "content": "tsx compiler/cli.ts",
    "content:watch": "tsx compiler/cli.ts --watch",
    "verify": "tsx tools/verify/index.ts",
    "statements": "tsx tools/statements/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/static": "^10.1.10",
    "@floating-ui/react": "^0.27.20",
    "@react-three/fiber": "^9.8.2",
    "fastify": "^5.12.8",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "katex": "^0.19.1",
    "mathjs": "^15.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.2.1",
    "hast-util-from-html": "^2.1.0",
    "mdast-util-directive": "^3.2.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
